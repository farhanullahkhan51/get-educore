{
  "version": 1,
  "sdk_version": "2.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://urrbkxkbfsmmlicmujly.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "educore",
      "version": "0.4.0",
      "title": "EduCore"
    },
    "tools": [
      {
        "name": "search_students",
        "title": "Search students",
        "description": "Find students by name or student ID. Returns name, student ID, status, grade, academic system and guardian contact.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "default": "",
              "description": "Name or student ID fragment. Leave empty to list recent students.",
              "type": "string"
            },
            "limit": {
              "default": 20,
              "description": "Maximum students to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_classes",
        "title": "List classes and sections",
        "description": "List the institution's classes with their sections, capacity and academic system (Board or Cambridge).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "academic_system": {
              "default": "all",
              "description": "Restrict to one academic track.",
              "type": "string",
              "enum": [
                "all",
                "board",
                "cambridge"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_staff",
        "title": "List staff",
        "description": "List staff members with designation, department, status and contact details.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "default": "",
              "description": "Name or staff ID fragment. Leave empty to list everyone.",
              "type": "string"
            },
            "limit": {
              "default": 25,
              "description": "Maximum staff records to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "fees_summary",
        "title": "Fees summary",
        "description": "Summarise fee challans: total billed, collected, outstanding, and how many challans are overdue. Optionally for one billing period (YYYY-MM).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "period": {
              "default": "",
              "description": "Billing period as YYYY-MM, e.g. 2026-07. Leave empty for all periods.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_inquiry",
        "title": "Create admission inquiry",
        "description": "Record a new admission inquiry in the admissions pipeline. Only supply details the user actually provided.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "student_name": {
              "type": "string",
              "minLength": 1,
              "description": "Prospective student's full name."
            },
            "guardian_name": {
              "type": "string",
              "minLength": 1,
              "description": "Guardian's full name."
            },
            "guardian_phone": {
              "type": "string",
              "minLength": 1,
              "description": "Guardian's contact number."
            },
            "guardian_email": {
              "default": "",
              "description": "Guardian's email, if known.",
              "type": "string"
            },
            "grade_applying_for": {
              "default": "",
              "description": "Class or grade applied for, e.g. Class 9.",
              "type": "string"
            },
            "academic_system": {
              "default": "unspecified",
              "description": "Preferred academic track.",
              "type": "string",
              "enum": [
                "unspecified",
                "board",
                "cambridge"
              ]
            },
            "notes": {
              "default": "",
              "description": "Any extra context from the enquiry.",
              "type": "string"
            }
          },
          "required": [
            "student_name",
            "guardian_name",
            "guardian_phone"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "analyze_timetable_clashes",
        "title": "Analyse timetable clashes",
        "description": "Scan a campus timetable for teacher double-bookings, room clashes, lessons placed in breaks, overloaded teacher days and assigned courses that have no periods yet.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "campus_id": {
              "description": "Campus id; defaults to the first campus visible to the user.",
              "type": "string"
            },
            "section": {
              "description": "Optional section name or id to focus on, e.g. 'Grade 9 A'.",
              "type": "string"
            },
            "teacher": {
              "description": "Optional teacher name or id to focus on.",
              "type": "string"
            },
            "max_daily_periods": {
              "default": 6,
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "optimize_timetable_schedule",
        "title": "Auto-fill timetable",
        "description": "Fill empty timetable slots with each section's assigned courses and teachers, clash-free, balanced across the week and respecting breaks. Existing lessons are never changed. Set apply=false to preview first.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "campus_id": {
              "type": "string"
            },
            "sections": {
              "description": "Section names or ids; omit for all sections with teaching assignments.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "max_daily_periods": {
              "default": 6,
              "description": "Maximum periods a teacher teaches per day.",
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "max_per_course_daily": {
              "default": 1,
              "description": "How often one subject may appear per day per section.",
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "apply": {
              "default": false,
              "description": "true = save to the timetable; false = preview only.",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "find_available_slots",
        "title": "Find free timetable slots",
        "description": "Find periods when the given teachers, sections and/or room are all free, e.g. 'when are the Physics teacher and Grade 9 A both free on Thursday?'.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "campus_id": {
              "type": "string"
            },
            "teachers": {
              "description": "Teacher names or ids.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sections": {
              "description": "Section names or ids.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "room": {
              "type": "string"
            },
            "day": {
              "default": "any",
              "type": "string",
              "enum": [
                "any",
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday",
                "Sunday"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "allocate_proxy_teacher",
        "title": "Allocate proxy teachers",
        "description": "For absent teachers on a date, list every lesson they would miss and rank free teachers to cover each one (same department and subject first, lightest load, fair weekly share). Set apply=true to save the recommended proxies.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "absent_teachers": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Names or ids of absent teachers."
            },
            "date": {
              "description": "YYYY-MM-DD; defaults to today.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "campus_id": {
              "type": "string"
            },
            "max_weekly_proxies": {
              "default": 4,
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "apply": {
              "default": false,
              "description": "true = save; false = preview only.",
              "type": "boolean"
            }
          },
          "required": [
            "absent_teachers"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "draft_bilingual_notice",
        "title": "Draft bilingual circular",
        "description": "Save a school circular in both English and Urdu. YOU write both versions: formal institutional English, and formal Urdu (Nastaliq script, respectful school-office register, e.g. 'والدین/سرپرست حضرات سے گزارش ہے'). Keep dates, amounts and names identical in both. Saved as a draft unless publish=true; gets the next CIR/YYYY/NNN number.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "title_en": {
              "type": "string",
              "minLength": 3,
              "maxLength": 140
            },
            "title_ur": {
              "type": "string",
              "minLength": 2,
              "maxLength": 140
            },
            "content_en": {
              "type": "string",
              "minLength": 10,
              "maxLength": 6000
            },
            "content_ur": {
              "type": "string",
              "minLength": 5,
              "maxLength": 6000
            },
            "category": {
              "default": "general",
              "type": "string",
              "enum": [
                "general",
                "academic",
                "administrative",
                "holiday",
                "examination",
                "fees"
              ]
            },
            "audience": {
              "default": "all",
              "type": "string",
              "enum": [
                "all",
                "staff",
                "students"
              ]
            },
            "priority": {
              "default": "normal",
              "type": "string",
              "enum": [
                "normal",
                "urgent",
                "critical"
              ]
            },
            "expires_at": {
              "description": "YYYY-MM-DD after which it auto-archives.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "publish": {
              "default": false,
              "description": "false = draft for review (recommended).",
              "type": "boolean"
            }
          },
          "required": [
            "title_en",
            "title_ur",
            "content_en",
            "content_ur"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_circular_for_translation",
        "title": "Get circular for translation",
        "description": "Fetch an existing circular by reference number (e.g. CIR/2026/004) or title words, split into English and Urdu, so you can translate it and save a bilingual version with draft_bilingual_notice.",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
